# Crede environment — copy to .env (plain Docker) or paste into Coolify.
# Every key here is read by docker-compose.yml; blanks fall back to the defaults shown there.


# Core
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_COOLIFY_POSTGRES_HOST:5432/DBNAME
SECRET_KEY=change-me-to-a-long-random-string
APP_URL=https://crede.collab.name.ng
ADMIN_EMAILS=
WEB_CONCURRENCY=1

# Auth
AUTH_MODE=local
ACCOUNTS_URL=https://accounts.collab.name.ng
ACCOUNTS_PUBLIC_URL=https://accounts.collab.name.ng
CORS_ORIGINS=https://crede.collab.name.ng
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# AI — primary, any OpenAI-compatible API (blank provider/model/base fall back to OPENAI_* → openai / gpt-4o-mini)
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI — secondary fallback (OpenAI-compatible)
LLM_SECONDARY_PROVIDER=
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_BASE_URL=
LLM_SECONDARY_MODEL=

# Career insights & central import
# INSIGHTS_AI: add a short AI narrative to dashboard insights (cached per profile, regenerated at most daily; uses LLM_*)
INSIGHTS_AI=true
# IMPORT_MAX_MB: max size of a file uploaded to Career Timeline → Import (parsed in memory, never stored)
IMPORT_MAX_MB=10

# Storage
STORAGE_ROOT=/data/crede
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=crede
S3_REGION=us-east-1

# Mail — blank SMTP_HOST means emails are only logged
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Crede <no-reply@collab.name.ng>
SMTP_TLS=starttls
MAIL_WORKER_INTERVAL_SECONDS=20

# Organisations — false: official email domain AND admin approval; true: domain alone approves
ORG_DOMAIN_AUTO_APPROVE=false

# Collab Teams two-way org sync (same SUITE_SYNC_TOKEN on both apps; blank TEAMS_URL disables)
TEAMS_URL=
SUITE_SYNC_TOKEN=
TEAMS_SYNC_INTERVAL_MINUTES=30

# Badges & payments — Paystack if its key is set, else Monnify, else simulated checkout (admins notified)
PAYSTACK_SECRET_KEY=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com
BADGE_PRICE_GRAY_NGN=2000
BADGE_PRICE_GREEN_NGN=5000

# Community
MAX_IMAGE_MB=8
REPORT_AUTOHIDE_THRESHOLD=3

# Optional services (blank = disabled; search falls back to SQL)
REDIS_URL=
MEILI_URL=
MEILI_MASTER_KEY=
API_PROXY_TARGET=http://crede-api:8008
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_ACCOUNTS_URL=https://accounts.collab.name.ng
NEXT_PUBLIC_APP_URL=https://crede.collab.name.ng
