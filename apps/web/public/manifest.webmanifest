{
  "name": "Crede — Verified Professional Identity",
  "short_name": "Crede",
  "description": "Your verified career, CVs that write themselves, and a community that vouches.",
  "id": "/feed",
  "start_url": "/feed?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#f7f7f8",
  "theme_color": "#f7f7f8",
  "categories": ["business", "productivity", "social"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Community", "url": "/feed", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Generate a CV", "url": "/generate", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Opportunities", "url": "/opportunities", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
