DATABASE_URL=postgresql://crede:crede@localhost:5434/crede
SECRET_KEY=change-me-in-production
AUTH_MODE=local
ACCOUNTS_URL=https://accounts.collab.name.ng
ACCOUNTS_PUBLIC_URL=https://accounts.collab.name.ng
COOKIE_DOMAIN=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,https://crede.collab.name.ng

# LLM — set in Coolify (no hardcoded vendor)
# LLM_PROVIDER: openai | runpod | replicate | none
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=2500
# Legacy aliases (still work if LLM_* unset):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

STORAGE_ROOT=/data/crede
REDIS_URL=redis://localhost:6379/0
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=
